{
    "name": "ataurbdx/translator",
    "description": "The Master Universal Translation & Localization Engine for Laravel, Flutter, and JavaScript.",
    "keywords": [
        "laravel",
        "translation",
        "localization",
        "i18n",
        "flutter",
        "mern",
        "polymorphic-translation",
        "bengali-translation",
        "number-to-words",
        "ai-translation",
        "ataurbdx"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ataur Rahman",
            "email": "ataurrahman.wub@gmail.com",
            "role": "Lead Architect"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/cache": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ataurbdx\\Translator\\": "packages/laravel/src/"
        },
        "files": [
            "packages/laravel/src/Helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ataurbdx\\Translator\\TranslationServiceProvider"
            ],
            "aliases": {
                "Translator": "Ataurbdx\\Translator\\Facades\\Translator"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "translator": {
            "type": "vcs",
            "url": "https://github.com/ataurbdx/translator.git"
        }
    }
}
